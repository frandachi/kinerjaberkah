# Database Configuration
DB_HOST=localhost
DB_USER=kpi_user
DB_PASS=your_secure_password_here
DB_NAME=kpi_corporate

# JWT Secret (Generate a strong random string)
JWT_SECRET=generate_a_strong_random_secret_here

# Server Configuration
PORT=5555
NODE_ENV=production

# CORS - Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://kinerjaberkah.banksumut.co.id

# License Activation Token
ACTIVATION_TOKEN=generate_a_random_activation_token_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@banksumut.co.id
SMTP_PASS=your_app_password_here

# Application URL
APP_URL=https://kinerjaberkah.banksumut.co.id
